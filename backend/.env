PORT=5000
NODE_ENV=development
JWT_SECRET=medtransfer_jwt_academic_secret_key_2026_btech
ENCRYPTION_KEY=medtransfer_aes256_academic_key_2026_dev
HMAC_SECRET=medtransfer_hmac_sha256_secret_key_2026_academic

# PostgreSQL Configuration
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=medtransfer_db

# Demo Clinical Data Mode (set to true to ensure 0 dummy data is present)
CLEAR_DUMMY_DATA=true
DATA_MODE=clean

# AI Provider Configuration (Ollama Local LLM)
AI_PROVIDER=external
AI_EXTERNAL_ENABLED=true
AI_MODEL=llama3.1:8b
AI_MODEL_VERSION=8b-instruct
AI_BASE_URL=http://localhost:11434/v1
AI_API_KEY=ollama
AI_TIMEOUT_MS=60000
AI_SEARCH_RETENTION=redacted

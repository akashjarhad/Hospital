# MedTransfer Server Configuration
PORT=5000
NODE_ENV=development

# Authentication & Cryptographic Keys (change for production)
JWT_SECRET=medtransfer_jwt_academic_secret_key_2026_btech
ENCRYPTION_KEY=medtransfer_aes256_academic_key_2026_dev
HMAC_SECRET=medtransfer_hmac_sha256_secret_key_2026_academic

# PostgreSQL Configuration (Optional: system automatically falls back to in-memory store if DB is offline)
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=medtransfer_db

# AI decision-support provider. "mock" is deterministic, offline, and labels outputs DEMO.
AI_PROVIDER=mock
AI_MODEL=external-model-name
AI_MODEL_VERSION=provider-managed
AI_BASE_URL=https://provider.example/v1
AI_API_KEY=
AI_TIMEOUT_MS=10000
# Search query retention: none | hash | redacted | full (redacted is the safe default)
AI_SEARCH_RETENTION=redacted
# External calls require explicit opt-in in addition to AI_PROVIDER and credentials.
AI_EXTERNAL_ENABLED=false
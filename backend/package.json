{
  "name": "medtransfer-backend",
  "version": "1.0.0",
  "description": "MedTransfer Backend API - Inter-Hospital Transfer Platform",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "nodemon src/server.js",
    "test": "node tests/test_full_exchange_workflow.js",
    "test:ai": "node tests/test_ai_consent_workflow.js",
    "test:security-research": "node tests/test_security_research_workflow.js",
    "test:py": "python -m unittest discover -s tests_py -p \"test_*.py\"",
    "test:all": "node tests/test_auth.js && node tests/test_patient_crud.js && node tests/test_full_exchange_workflow.js && node tests/test_ai_consent_workflow.js && node tests/test_security_research_workflow.js && python -m unittest discover -s tests_py -p \"test_*.py\"",
    "ml:train": "python ml/training/train_anomaly_model.py && python ml/training/train_complexity_model.py",
    "ml:eval": "python -m ml.evaluation",
    "db:seed": "node src/db/seed.js",
    "db:clean": "node src/db/cleanData.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "nodemon": "^3.1.4"
  }
}
